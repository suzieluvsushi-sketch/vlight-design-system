            "value": "32px control / 16px icon"
          }
        },
        {
          "kind": "guideline",
          "property": "Component styling",
          "before": {
            "value": "Consumer override"
          },
          "after": {
            "value": "Published Button API"
          }
        }
      ],
      "affectedAssets": [
        "component.message"
      ]
